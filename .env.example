# Docker Compose deployment
LAYERLEAK_IMAGE=ghcr.io/brumbelow/layerleak:latest
LAYERLEAK_API_HOST=127.0.0.1
LAYERLEAK_API_PORT=8080
LAYERLEAK_DB_NAME=layerleak
LAYERLEAK_DB_USER=layerleak
# Required by docker-compose.yml, which refuses to start until it is set.
# Generate a strong value; it is passed to the containers as PGPASSWORD.
LAYERLEAK_DB_PASSWORD=
# How long Compose waits for the API to drain before killing it; keep it above
# LAYERLEAK_API_SHUTDOWN_TIMEOUT.
LAYERLEAK_API_STOP_GRACE_PERIOD=35s

# Process and output
# One of debug, info, warn, error.
LAYERLEAK_LOG_LEVEL=info
# CLI only: directory for saved scan records. Blank uses the default location.
LAYERLEAK_FINDINGS_DIR=
# host:port for the API listener; the container image defaults to 0.0.0.0:8080.
LAYERLEAK_API_ADDR=127.0.0.1:8080
# Unsafe opt-in: persist raw secret values and raw context snippets.
# Accepts 1/true/yes/on or 0/false/no/off.
LAYERLEAK_PERSIST_RAW_SECRETS=0

# API request and server bounds (must be positive unless noted)
LAYERLEAK_API_MAX_REQUEST_BYTES=16384
LAYERLEAK_API_SCAN_TIMEOUT=30m
LAYERLEAK_API_MAX_CONCURRENT_SCANS=1
LAYERLEAK_API_READ_HEADER_TIMEOUT=5s
LAYERLEAK_API_READ_TIMEOUT=15s
LAYERLEAK_API_RESPONSE_WRITE_TIMEOUT=30s
LAYERLEAK_API_IDLE_TIMEOUT=60s
LAYERLEAK_API_SHUTDOWN_TIMEOUT=30s
# Drain window after SIGTERM: /readyz reports 503 while in-flight requests
# finish; may be 0s. Keep LAYERLEAK_API_STOP_GRACE_PERIOD above the sum of this
# and LAYERLEAK_API_SHUTDOWN_TIMEOUT.
LAYERLEAK_API_PRESTOP_DELAY=0s
LAYERLEAK_API_READINESS_TIMEOUT=2s

# Registry egress and request bounds
LAYERLEAK_HTTP_TIMEOUT=30s
LAYERLEAK_BLOB_TIMEOUT=10m
LAYERLEAK_SCAN_TIMEOUT=30m
# The three bounds below must be positive.
LAYERLEAK_REGISTRY_REQUEST_ATTEMPTS=2
LAYERLEAK_REGISTRY_MAX_REDIRECTS=3
LAYERLEAK_MAX_AUTH_RESPONSE_BYTES=1048576
# Comma-separated exact DNS hostname, IPv4, host:port, or bracketed IPv6:port
# entries. Schemes, paths, credentials, wildcards, and unbracketed IPv6 are
# rejected. Private destinations remain blocked when these lists are empty.
LAYERLEAK_ALLOWED_PRIVATE_REGISTRY_HOSTS=
LAYERLEAK_ALLOWED_PRIVATE_AUTH_HOSTS=
# Optional endpoint overrides; normally leave blank.
LAYERLEAK_REGISTRY_BASE_URL=
LAYERLEAK_REGISTRY_AUTH_URL=

# Scan resource bounds. A value of 0 disables a bound except where noted.
# Must be positive; larger files are skipped and coverage becomes partial.
LAYERLEAK_MAX_FILE_BYTES=1048576
LAYERLEAK_MAX_LAYER_BYTES=536870912
LAYERLEAK_MAX_LAYER_ENTRIES=50000
LAYERLEAK_MAX_IMAGE_LAYERS=512
LAYERLEAK_MAX_IMAGE_MANIFESTS=64
LAYERLEAK_MAX_IMAGE_LAYER_BYTES=4294967296
LAYERLEAK_MAX_IMAGE_ARTIFACTS=250000
LAYERLEAK_MAX_RETAINED_BYTES=1073741824
LAYERLEAK_MAX_MANIFEST_BYTES=8388608
LAYERLEAK_MAX_CONFIG_BYTES=8388608
LAYERLEAK_MAX_TAG_RESPONSE_BYTES=8388608
LAYERLEAK_MAX_FINDINGS_PER_SCAN=10000
# Aggregate raw value and snippet bytes retained when raw persistence is on.
LAYERLEAK_MAX_RAW_FINDING_BYTES=67108864
# Must be positive.
LAYERLEAK_TAG_PAGE_SIZE=100
LAYERLEAK_MAX_REPOSITORY_TAGS=1000
LAYERLEAK_MAX_REPOSITORY_TARGETS=250

# Local PostgreSQL persistence. Leave blank to run the CLI without a database.
# Compose builds its service URL from the LAYERLEAK_DB_* values above instead.
# Use a dedicated non-superuser role and verify the server certificate, e.g.
#   postgres://layerleak@db.example.internal:5432/layerleak?sslmode=verify-full&sslrootcert=/etc/ssl/certs/db-ca.pem
# The password may be supplied through PGPASSWORD or PGPASSFILE instead of
# the URL.
LAYERLEAK_DATABASE_URL=
# Must be positive.
LAYERLEAK_DATABASE_MAX_OPEN_CONNS=10
LAYERLEAK_DATABASE_MAX_IDLE_CONNS=5
LAYERLEAK_DATABASE_CONN_MAX_LIFETIME=30m
LAYERLEAK_DATABASE_CONN_MAX_IDLE_TIME=5m
LAYERLEAK_DATABASE_QUERY_TIMEOUT=10s
LAYERLEAK_DATABASE_WRITE_TIMEOUT=2m
# Read only by layerleak-migrate-up. The container default is /app/migrations;
# from a checkout use "$PWD/migrations".
LAYERLEAK_MIGRATIONS_DIR=
